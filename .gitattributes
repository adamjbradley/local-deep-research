# Normalize line endings: text files are stored as LF in the repo and
# checked out as LF on all platforms. Prevents CRLF churn from Windows/WSL.
* text=auto eol=lf

# Explicit binary types (never touch these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
